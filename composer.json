{
    "name": "lhaamed/naame-bar",
    "description": "Laravel SMS integration with SMS.ir support.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "laravel/framework": "^11.0 || ^12.0 || ^13.0"
    },
    "scripts": {
        "test": "@php tests/run.php"
    },
    "autoload": {
        "psr-4": {
            "lhaamed\\NaameBar\\": "src/"
        }
    },
    "authors": [
        {
            "name": "lhaamed",
            "email": "lhaamed.business@gmail.com"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "lhaamed\\NaameBar\\NaameBarServiceProvider"
            ],
            "aliases": {
                "NaameBar": "lhaamed\\NaameBar\\NaameBar"
            }
        }
    }
}
